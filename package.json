{
  "name": "@shreejitverma/x-axi",
  "version": "0.6.1",
  "description": "AXI-compliant CLI for X: read data and manage your account, with a human approval gate on every write",
  "keywords": [
    "x",
    "twitter",
    "x-api",
    "cli",
    "axi",
    "agent",
    "oauth2",
    "pkce"
  ],
  "author": "Shreejit Verma",
  "license": "MIT",
  "homepage": "https://github.com/shreejitverma/x-axi#readme",
  "bugs": {
    "url": "https://github.com/shreejitverma/x-axi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreejitverma/x-axi.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "bin": {
    "x-axi": "dist/bin/x-axi.js"
  },
  "files": [
    "dist/bin/*.js",
    "dist/src/*.js",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/bin/x-axi.js', 0o755)\"",
    "test": "vitest run",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@toon-format/toon": "^4.4.0",
    "axi-sdk-js": "^0.1.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
